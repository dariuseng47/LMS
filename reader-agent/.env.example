# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า

# ที่อยู่ server (ไม่ต้องมี /api/v1 ต่อท้าย)
SERVER_URL=https://api.welcleankhoka.com

# device token ของเครื่องอ่าน RFID (เช่น SID จุดตรวจสอบ) — ได้จากหน้าเว็บ "อุปกรณ์ & สัญญาณ RFID"
# ตอนเพิ่มอุปกรณ์ หรือกด "รีเซ็ต token" (แสดงครั้งเดียว)
DEVICE_TOKEN=

# ชื่อเครื่องนี้ ไว้ดูใน log ของ server (ไม่ใส่ = ใช้ชื่อคอม)
AGENT_NAME=
