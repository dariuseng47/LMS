<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical">

    <!--algorithm-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="@dimen/subtitle"
        android:gravity="center_vertical"
        android:text="@string/dynamic"
        android:textSize="@dimen/font_normal_16"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_item"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="8"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="2"
                android:gravity="center"
                android:text="@string/startq"
                android:textSize="@dimen/font_middle_14"/>

            <EditText
                android:id="@+id/et_start_q"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/four"
                android:layout_weight="2"
                android:background="@drawable/edittextstyle"
                android:gravity="center"
                android:inputType="number"
                android:textColor="#ff006600"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="2"
                android:gravity="center"
                android:text="@string/minq"
                android:textSize="@dimen/font_middle_14"/>

            <EditText
                android:id="@+id/et_min_q"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="2"
                android:background="@drawable/edittextstyle"
                android:gravity="center"
                android:text="@string/zero"
                android:inputType="number"
                android:textColor="#ff006600"/>


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="2"
                android:gravity="center"
                android:text="@string/maxq"
                android:textSize="@dimen/font_middle_14"/>

            <EditText
                android:id="@+id/et_max_q"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="2"
                android:text="@string/fifteen"
                android:background="@drawable/edittextstyle"
                android:gravity="center"
                android:inputType="number"
                android:textColor="#ff006600"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/q_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_weight="1"
            android:src="@drawable/alert_circle_outline"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_item"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="4dp"
            android:layout_weight="4"
            android:gravity="center"
            android:text="@string/retrycount"
            android:textSize="@dimen/font_middle_14"/>

        <EditText
            android:id="@+id/et_retry_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="4"
            android:text="@string/zero"
            android:background="@drawable/edittextstyle"
            android:gravity="center"
            android:inputType="number"
            android:textColor="#ff006600"/>

        <ImageView
            android:id="@+id/retry_count_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_weight="1"
            android:src="@drawable/alert_circle_outline"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_item"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="4dp"
            android:layout_weight="4"
            android:gravity="center"
            android:text="@string/thresholdmultiplier"
            android:textSize="@dimen/font_middle_14"/>

        <EditText
            android:id="@+id/et_threshold_multiplier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="4"
            android:text="@string/zero"
            android:background="@drawable/edittextstyle"
            android:gravity="center"
            android:inputType="number"
            android:textColor="#ff006600"/>

        <ImageView
            android:id="@+id/threshold_multiplier_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_weight="1"
            android:src="@drawable/alert_circle_outline"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_set_q"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/font_normal_16"
        android:text="@string/set"
        android:textSize="@dimen/font_middle_14"/>
</LinearLayout>