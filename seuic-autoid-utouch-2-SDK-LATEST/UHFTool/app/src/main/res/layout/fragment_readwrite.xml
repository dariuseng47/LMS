<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
        android:id="@+id/rl_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">

        <TextView
            android:id="@+id/tv_tag_select"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="@string/tag_select"/>

        <Spinner
            android:id="@+id/sp_tag"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/edittextstyle"
            android:gravity="center"/>

        </LinearLayout>

        <View
            android:layout_width="fill_parent"
            android:layout_height="2dip"
            android:layout_marginTop="5dp"
            android:background="#66000000"/>

        <ScrollView
        android:id="@+id/sl_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="@dimen/font_middle_14"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_readwrite"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:background="#A7A6A6"
                android:gravity="center"
                android:text="@string/msg_readwrite"/>

            <RadioGroup
                android:id="@+id/rg_bank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_bank_epc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/font_middle_14"
                    android:text="@string/msg_epc" />

                <RadioButton
                    android:id="@+id/rb_bank_tid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/font_middle_14"
                    android:text="@string/msg_tid" />

                <RadioButton
                    android:id="@+id/rb_bank_user"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/font_middle_14"
                    android:text="@string/msg_user"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rb_bank_psw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/font_middle_14"
                    android:text="@string/msg_reserved" />

            </RadioGroup>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_address"
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.5"
                    android:gravity="center"
                    android:text="@string/msg_address"/>

                <EditText
                    android:layout_weight="1"
                    android:id="@+id/et_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textSize="@dimen/font_middle_14"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tv_lengh"
                    android:layout_width="0dp"
                    android:layout_height="fill_parent"
                    android:layout_weight="1.2"
                    android:gravity="center"
                    android:text="@string/msg_lengh"/>

                <EditText
                    android:layout_weight="1"
                    android:id="@+id/et_length"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textSize="@dimen/font_middle_14"
                    android:gravity="center" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ac_psw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/msg_ac_psw"/>

                <EditText
                    android:id="@+id/et_ac_password"
                    android:textSize="@dimen/font_middle_14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_data"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="@string/tag_data"/>

                <EditText
                    android:id="@+id/et_rw_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/font_middle_14"
                    android:gravity="left|top"
                    android:inputType="textMultiLine"
                    android:padding="5dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bt_read"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:layout_weight="1"
                    android:textSize="@dimen/font_middle_15"
                    android:text="@string/msg_read_card" />

                <Button
                    android:id="@+id/bt_write"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:layout_weight="1"
                    android:textSize="@dimen/font_middle_15"
                    android:text="@string/msg_write_card" />

                <Button
                    android:id="@+id/bt_clear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:layout_weight="1"
                    android:textSize="@dimen/font_middle_15"
                    android:text="@string/msg_clear" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/bt_blockwrite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:layout_weight="1"
                    android:textSize="@dimen/font_middle_15"
                    android:text="@string/msg_block_write" />

                <Button
                    android:id="@+id/bt_blockerase"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:layout_weight="1"
                    android:textSize="@dimen/font_middle_15"
                    android:text="@string/msg_block_erase" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_lock"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:background="#A7A6A6"
                android:gravity="center"
                android:text="@string/msg_lock"/>

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_lock_bank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/lock_bank"/>

                <Spinner
                    android:id="@+id/sp_lock_bank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/font_middle_14"
                    android:entries="@array/msg_bank_choose" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_lock_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/lock_mode"/>

                <Spinner
                    android:id="@+id/sp_lock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/font_small_12"
                    android:entries="@array/lock" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_lock_ac_psw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/msg_ac_psw"/>

                <EditText
                    android:id="@+id/ed_lock_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/font_middle_14"
                    android:gravity="center" />

            </LinearLayout>
            <TextView
                android:id="@+id/tv_lock_warning"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:textSize="@dimen/font_small_12"
                android:text="@string/lock_warning"/>
            <Button
                android:id="@+id/bt_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/font_middle_15"
                android:text="@string/msg_lock" />

            <TextView
                android:id="@+id/tv_kill"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:background="#A7A6A6"
                android:gravity="center"
                android:text="@string/msg_kill"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_kill_psw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/msg_kill_psw"/>

                <EditText
                    android:id="@+id/ed_kill_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/font_middle_14"
                    android:gravity="center" />

            </LinearLayout>

            <Button
                android:id="@+id/bt_kill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/msg_kill"
                android:textSize="@dimen/font_middle_15"/>

        </LinearLayout>

    </ScrollView>

    </LinearLayout>

</RelativeLayout>