# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (.env ไม่ถูก commit เข้า git)

NODE_ENV=development
PORT=4000

# origin ของ dashboard (คั่นด้วย , ได้หลายค่า) — ต้องตรงกับ URL ที่ dashboard รันอยู่จริงเพื่อให้ CORS ผ่าน
CORS_ORIGIN=http://localhost:3033

# ===== MySQL Database (กรอกตามข้อมูล DB จริงของคุณ) =====
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=laundry_db
DB_SSL=false
DB_CONNECTION_LIMIT=10

# ===== JWT Secrets (สุ่มด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") =====
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
