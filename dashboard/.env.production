# ใช้ตอน `next build` (export static สำหรับ welcleankhoka.com) — มีความสำคัญเหนือ .env
# ค่า NEXT_PUBLIC_* ถูกฝังลงไฟล์ JS ตอน build (เปลี่ยนค่า = ต้อง build ใหม่) และเป็นค่า public ไม่ใช่ความลับ
# ตอนพัฒนา (`next dev`) ยังใช้ค่าจาก .env ตามเดิม
NEXT_PUBLIC_SERVER_URL=https://api.welcleankhoka.com/api/v1
